# GitHub Actions Runner Orchestrator Configuration
# Copy this file to orchestrator.env and fill in your values

# GitHub Configuration (REQUIRED)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO=deepongi-labs/android14-6.1.162-common-2026-03

# Runner Scaling Configuration
MAX_RUNNERS=4
MIN_RUNNERS=1
RUNNER_IDLE_TIMEOUT=600
POLL_INTERVAL=30

# Docker Configuration
RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest

# Logging
LOG_LEVEL=INFO
