[Unit]
Description=GitHub Actions Runner Orchestrator
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/Android/gki-kernel-builder/.github/orchestrator
EnvironmentFile=/mnt/Android/gki-kernel-builder/.github/orchestrator/orchestrator.env
ExecStart=/usr/bin/python3 /mnt/Android/gki-kernel-builder/.github/orchestrator/runner-orchestrator.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
