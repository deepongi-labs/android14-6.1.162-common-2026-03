--- a/drivers/video/backlight/backlight.c
+++ b/drivers/video/backlight/backlight.c
@@ -21,6 +21,10 @@
 #include <linux/ctype.h>
 #include <asm/backlight.h>

+#ifdef CONFIG_KLAPSE
+#include <linux/klapse.h>
+#endif
+
 /**
  * DOC: overview
  *
@@ -122,6 +126,17 @@ static int backlight_update_status(struct backlight_device *bd)
 		brightness = READ_ONCE(bd->props.brightness);
 		brightness = backlight_get_brightness(bd, brightness);
 		ret = ops->update_status(bd);
+
+#ifdef CONFIG_KLAPSE
+		/* Call KLapse with HBM support */
+		if (!ret && brightness >= 0) {
+			/* Enable HBM for brightness > 90% of max */
+			if (brightness > (bd->props.max_brightness * 9 / 10)) {
+				/* HBM mode - maximum brightness */
+				set_rgb_slider(bd->props.max_brightness);
+			} else {
+				set_rgb_slider(brightness);
+			}
+		}
+#endif
 	}

 	return ret;
